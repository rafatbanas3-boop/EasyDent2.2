		<PackageReference Include="Microsoft.Fast.Components.FluentUI.Icons" Version="3.8.0" />
		<PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.4" />
		<PackageReference Include="NTwain" Version="3.7.6" />
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
		<PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
	</ItemGroup>

</Project>
